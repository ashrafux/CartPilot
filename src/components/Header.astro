---
// Site header + mobile drawer. The current page's nav link and Platforms/Resources entry get aria-current="page".
const path = Astro.url.pathname;
const cur = (href: string) => (href === path ? "page" : undefined);
---
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header" data-header>
  <div class="container site-header__in">
    <a class="logo" href="/" aria-label="CartPilot home"><img class="logo__img" src="/assets/img/cartpilot-logo-updated.svg" alt="CartPilot" width="160" height="40"><img class="logo__img logo__img--white" src="/assets/img/cartpilot-logo-white.svg" alt="" width="160" height="40"></a>
    <nav class="nav" aria-label="Primary">
      <a class="nav__link" href="/features/" aria-current={cur("/features/")}>Features</a>
      <div class="nav__item" data-dropdown>
        <button class="nav__link" type="button" aria-expanded="false" aria-controls="mega-platforms">Platforms <img class="chev" src="/assets/icons/chevron-down.svg" alt="" width="10" height="7"></button>
        <div class="mega mega--wide" id="mega-platforms">
          <a class="mega__link" href="/woocommerce/" aria-current={cur("/woocommerce/")}><img class="plat-logo plat-logo--woo" src="/assets/img/woo-logo.png" alt="" width="40" height="28"><span><span class="mega__title">WooCommerce</span><span class="mega__desc" style="display:block">The WordPress plugin for your store</span></span></a>
          <a class="mega__link" href="/shopify/" aria-current={cur("/shopify/")}><img class="plat-logo" src="/assets/img/shopify-logo.png" alt="" width="40" height="28"><span><span class="mega__title">Shopify</span><span class="mega__desc" style="display:block">The app for your Shopify store</span></span></a>
          <span class="mega__link is-soon" aria-disabled="true"><img class="plat-logo" src="/assets/icons/flycommerce.svg" alt="" width="40" height="28"><span><span class="mega__title">FlyCommerce</span><span class="mega__desc" style="display:block">Coming soon...</span></span></span>
        </div>
      </div>
      <div class="nav__item" data-dropdown>
        <button class="nav__link" type="button" aria-expanded="false" aria-controls="mega-resources">Resources <img class="chev" src="/assets/icons/chevron-down.svg" alt="" width="10" height="7"></button>
        <div class="mega" id="mega-resources">
          <a class="mega__link" href="/blog/" aria-current={cur("/blog/")}><img src="/assets/icons/mm-blog.svg" alt=""><span><span class="mega__title">Blog</span><span class="mega__desc" style="display:block">Latest news and articles</span></span></a>
          <a class="mega__link" href="/docs/" aria-current={cur("/docs/")}><img src="/assets/icons/mm-docs.svg" alt=""><span><span class="mega__title">Documentation</span><span class="mega__desc" style="display:block">Your step-by-step playbook</span></span></a>
          <a class="mega__link" href="/faq/" aria-current={cur("/faq/")}><img src="/assets/icons/mm-faq.svg" alt=""><span><span class="mega__title">FAQ</span><span class="mega__desc" style="display:block">Common questions answered</span></span></a>
        </div>
      </div>
      <a class="nav__link" href="/contact/" aria-current={cur("/contact/")}>Contact Us</a>
    </nav>
    <div class="header-actions">
      <a class="header-login" href="https://app.cartpilot.ai/">Login</a>
      <a class="btn btn--secondary btn--sm header-cta" href="/pricing/">Pricing</a>
    </div>
    <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="drawer" data-burger><span></span></button>
  </div>
  <div class="drawer" id="drawer" aria-label="Mobile menu">
    <div class="drawer__top">
      <a class="logo" href="/"><img src="/assets/img/cartpilot-logo-updated.svg" alt="CartPilot" width="160" height="40"></a>
      <button class="burger" type="button" aria-label="Close menu" data-burger><span></span></button>
    </div>
    <div class="drawer__links">
      <a href="/features/">Features</a>
      <div class="drawer__group" data-drawer-group>
        <button type="button" aria-expanded="false">Platforms <img src="/assets/icons/chevron-down.svg" alt="" width="12" height="8"></button>
        <div class="drawer__sub"><div>
          <a class="mega__link" href="/woocommerce/" aria-current={cur("/woocommerce/")}><img class="plat-logo plat-logo--woo" src="/assets/img/woo-logo.png" alt="" width="40" height="28"><span><span class="mega__title">WooCommerce</span><span class="mega__desc" style="display:block">The WordPress plugin for your store</span></span></a>
          <a class="mega__link" href="/shopify/" aria-current={cur("/shopify/")}><img class="plat-logo" src="/assets/img/shopify-logo.png" alt="" width="40" height="28"><span><span class="mega__title">Shopify</span><span class="mega__desc" style="display:block">The app for your Shopify store</span></span></a>
          <span class="mega__link is-soon" aria-disabled="true"><img class="plat-logo" src="/assets/icons/flycommerce.svg" alt="" width="40" height="28"><span><span class="mega__title">FlyCommerce</span><span class="mega__desc" style="display:block">Coming soon...</span></span></span>
        </div></div>
      </div>
      <div class="drawer__group" data-drawer-group>
        <button type="button" aria-expanded="false">Resources <img src="/assets/icons/chevron-down.svg" alt="" width="12" height="8"></button>
        <div class="drawer__sub"><div>
          <a class="mega__link" href="/blog/" aria-current={cur("/blog/")}><img src="/assets/icons/mm-blog.svg" alt=""><span><span class="mega__title">Blog</span><span class="mega__desc" style="display:block">Latest news and articles</span></span></a>
          <a class="mega__link" href="/docs/" aria-current={cur("/docs/")}><img src="/assets/icons/mm-docs.svg" alt=""><span><span class="mega__title">Documentation</span><span class="mega__desc" style="display:block">Your step-by-step playbook</span></span></a>
          <a class="mega__link" href="/faq/" aria-current={cur("/faq/")}><img src="/assets/icons/mm-faq.svg" alt=""><span><span class="mega__title">FAQ</span><span class="mega__desc" style="display:block">Common questions answered</span></span></a>
        </div></div>
      </div>
      <a href="/contact/">Contact Us</a>
    </div>
    <a class="btn btn--secondary" href="/pricing/">Pricing</a>
    <a class="drawer__login" href="https://app.cartpilot.ai/">Login</a>
  </div>
</header>
