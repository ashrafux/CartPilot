      <nav class="footer-links" aria-label="Footer">
        <div>
          <h6>Product</h6>
          <ul>
            <li><a href="/features/">Features</a></li>
            <li><a href="/pricing/">Pricing</a></li>
            <li><a href="/docs/">Documentation</a></li>
            <li><a href="/blog/">Blog</a></li>
            <li><a href="/contact/">Contact Us</a></li>
          </ul>
        </div>
        <div>
          <h6>Platforms</h6>
          <ul>
            <li><a href="/woocommerce/">WooCommerce</a></li>
            <li><a href="/shopify/">Shopify</a></li>
          </ul>
        </div>
        <div>
          <h6>StorePulse Suite</h6>
          <ul>
            <li><a href="https://storepulse.co/tryaura" target="_blank" rel="noopener">TryAura</a></li>
            <li><a href="https://storepulse.co/storegrowth/" target="_blank" rel="noopener">StoreGrowth</a></li>
            <li><a href="https://cartpulse.co/" target="_blank" rel="noopener">CartPulse</a></li>
            <li><a href="https://wedevs.com/woocommerce-conversion-tracking/" target="_blank" rel="noopener">Conversion Tracking</a></li>
            <li><a href="https://storepulse.co/pocketstore/" target="_blank" rel="noopener">PocketStore</a></li>
          </ul>
        </div>
        <div>
          <h6>Others</h6>
