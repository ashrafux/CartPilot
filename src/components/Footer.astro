            <li><a href="/affiliate/">Join Us As Affiliates</a></li>
            <li><a href="/refund-policy/">Refund Policy</a></li>
            <li><a href="/terms-of-service/">Terms of Service</a></li>
            <li><a href="/privacy-policy/">Privacy Policy</a></li>
            <li><a href="/affiliate-terms-and-conditions/">Affiliate Terms</a></li>
            <li><a href="/faq/">FAQ</a></li>
          </ul>
        </div>
      </nav>
    </div>
    <div class="footer-word" aria-hidden="true"><span></span></div>
    <div class="footer-base">
      <span class="by">A <img src="/assets/img/wedevs-logo.svg" alt="weDevs" width="108" height="24" loading="lazy"> product</span>
