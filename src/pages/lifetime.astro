    .lplan__feats li:first-child { color: var(--ink); font-weight: 700; }
    .lplan__feats svg { width: 20px; height: 20px; flex: none; margin-top: 2px; padding: 4px; border-radius: 50%; background: #dcfce7; color: #16a34a; }
    .lplans__guard { display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 32px; font-family: var(--font); font-size: 16px; font-weight: 500; color: var(--ink); }
    .lplans__guard svg { width: 22px; height: 22px; color: #16a34a; }
    .lnote { display: flex; align-items: center; gap: 20px; width: fit-content; max-width: 860px; margin: 32px auto 0; padding: 28px 36px 28px 28px;
      border-radius: 10px; background: rgb(0 84 255 / .1); font-size: 16px; line-height: 1.55; color: #4b5563; text-align: left; }
    .lnote__ico { width: 48px; height: 48px; flex: none; border-radius: 50%; display: grid; place-items: center; background: #fff; color: var(--blue);
      box-shadow: 0 0 0 1px #e3e9f8, 0 6px 14px -8px rgb(0 84 255 / .5); }
    .lnote__ico svg { width: 22px; height: 22px; }
    .lnote strong { font-weight: 700; color: var(--ink); }

    @media (max-width: 1024px) {
      .laud__grid { grid-template-columns: 1fr; }
      .lcard { min-height: 0; flex-direction: row; align-items: center; gap: 24px; padding: 28px; }
      .lplans__grid { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; }
      .lshow__grid { grid-template-columns: 1fr; }
      .lshow__grid > div { order: -1; }   /* art above the list once they stack */
    }
    @media (max-width: 781px) {
      .lsteps__path { display: none; }
      .lsteps__grid { grid-template-columns: 1fr; gap: 48px; }
      .lstep:nth-child(2) { padding-top: 0; }
      .lfeat__grid, .lvs__grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 640px) {
      .lifetime-page { --lift: 120px; }
      .lhero { padding: calc(88px + 48px) 0 calc(var(--lift) + 40px); }
      .lhead p { margin-top: 14px; }
      .laud__grid, .lfeat__grid, .lvs__grid, .lshow__grid { margin-top: 36px; }
      .lcard { flex-direction: column; align-items: flex-start; padding: 28px 22px; gap: 24px; }
      .lcard__ico { width: 60px; height: 60px; }
      .lcard__ico svg { width: 26px; height: 26px; }
      .lsteps__zz { margin-top: 40px; }
      .lbill { margin-top: 40px; padding: 16px; flex-direction: column; width: 100%; }
      .lbill__plus { line-height: 1; }
      .lbill__item { width: 100%; }
      .lbill__item b, .lbill__item em { white-space: nowrap; }
      .lbill__item em { margin-left: auto; }
      .lfi { min-height: 0; padding: 12px 16px 12px 12px; gap: 12px; }
      .lfi__ico { width: 40px; height: 40px; }
      .lfi__ico svg { width: 19px; height: 19px; }
      .lfi__t { font-size: 16px; }
      .lvs__card { padding: 28px 22px; }
      .lvs__card .btn { width: 100%; }
      .lshow__btn { padding: 12px; gap: 12px; }
      .lshow__btn b { font-size: 16px; }
      .lplan { padding: 28px 22px; }
      .lplan__desc { min-height: 0; }
      .lnote { margin-top: 24px; align-items: flex-start; gap: 14px; padding: 16px 18px 16px 14px; }
      .lnote__ico { width: 40px; height: 40px; }
      .lnote__ico svg { width: 19px; height: 19px; }
    }
  </style>
</Fragment>

