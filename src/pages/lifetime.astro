      .lhub__chips { display: grid; grid-template-columns: 1fr 1fr; width: 100%; gap: 8px; }
      .lchip { width: 100%; padding: 8px 12px 8px 8px; gap: 8px; font-size: 14px; text-align: left; }
      .lchip__ico { width: 30px; height: 30px; }
      .lchip__ico svg { width: 15px; height: 15px; }
      .lwid__b { height: 330px; }
      .lshow__cap { font-size: 15px; }
      .lcard { flex-direction: column; align-items: flex-start; padding: 28px 22px; gap: 24px; }
