---
// /lifetime/ — the WooCommerce Lifetime deal (pay once, bring your own AI key).
// Reached from the "Lifetime" button beside the Monthly / Annual toggle on /pricing/.
// The plan cards use the same checkout links and launch coupon as the old Lifetime tab on the pricing page.
import Base from "../layouts/Base.astro";
import Faq from "../components/Faq.astro";
import CtaSky from "../components/CtaSky.astro";

const title = "Lifetime Deal: Pay Once, Bring Your Own AI Key | CartPilot";
const description = "Get CartPilot for your WooCommerce store with a single payment. Connect your own AI provider key, pay the provider directly for what you use, and never pay CartPilot a monthly fee. 7-day money-back guarantee.";

// Lucide-style 24px stroke icons
const svg = (d: string, w = "1.9") => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${w}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const I = {
  trend: '<path d="m22 7-8.5 8.5-5-5L2 17"/><path d="M16 7h6v6"/>',
  brief: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',
  lock: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  cart: '<circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>',
  key: '<path d="m15.5 7.5 2.3 2.3a1 1 0 0 0 1.4 0l2.1-2.1a1 1 0 0 0 0-1.4L19 4"/><path d="m21 2-9.6 9.6"/><circle cx="7.5" cy="15.5" r="5.5"/>',
  zap: '<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>',
  search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  bag: '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
  ticket: '<path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/>',
  spark: '<path d="M12 3l1.9 5.8L20 11l-6.1 2.2L12 19l-1.9-5.8L4 11l6.1-2.2z"/><path d="M19 3v4"/><path d="M17 5h4"/>',
  mic: '<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><path d="M12 19v3"/>',
  chat: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>',
  box: '<path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>',
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  chart: '<path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>',
  sliders: '<path d="M4 21v-7"/><path d="M4 10V3"/><path d="M12 21v-9"/><path d="M12 8V3"/><path d="M20 21v-5"/><path d="M20 12V3"/><path d="M1 14h6"/><path d="M9 8h6"/><path d="M17 16h6"/>',
  layers: '<path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  shield: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  send: '<path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/>',
  grid: '<rect x="3" y="4" width="7" height="7" rx="1.5"/><rect x="14" y="4" width="7" height="7" rx="1.5"/><rect x="3" y="15" width="7" height="6" rx="1.5"/><rect x="14" y="15" width="7" height="6" rx="1.5"/>',
  info: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>',
};
const CHECK = svg(I.check, "2.6");
// gradient infinity mark (blue → violet → pink, same as the Lifetime button on /pricing/)
const INF = (id: string) => `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><defs><linearGradient id="${id}" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#3b7bff"/><stop offset=".55" stop-color="#8b5cff"/><stop offset="1" stop-color="#f05aa8"/></linearGradient></defs><path d="M12 12c-2-2.67-4-4-6-4a4 4 0 1 0 0 8c2 0 4-1.33 6-4Zm0 0c2 2.67 4 4 6 4a4 4 0 0 0 0-8c-2 0-4 1.33-6 4Z" stroke="url(#${id})" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

const audience = [
  { ico: I.trend, tone: "blue", t: "Busy Stores", p: "Your CartPilot cost stays the same however many conversations you have. You only pay your AI provider for what you use." },
  { ico: I.grid, tone: "violet", t: "Agencies With Client Stores", p: "One purchase covers up to 20 WooCommerce stores, so you can add CartPilot to client sites without a new subscription each time." },
  { ico: I.key, tone: "pink", t: "Owners Who Like Control", p: "Choose your AI provider, keep an eye on usage in their dashboard, and decide how much to spend." },
];

const steps = [
  { ico: I.cart, t: "Pick your plan and pay once", p: "Choose the plan that covers your stores. There are no renewals and no monthly CartPilot fee." },
  { ico: I.key, t: "Connect your store and your AI key", p: "Install the WordPress plugin, connect your store, then add your AI provider key in your CartPilot settings." },
  { ico: I.zap, t: "Start selling", p: "CartPilot helps your shoppers using your key, and your provider bills you directly for what you use." },
];

// [icon, title, description, plan note]
const feats: [string, string, string, string?][] = [
  [I.search, "Natural language search", "Shoppers describe what they want, and CartPilot finds it."],
  [I.spark, "Smart recommendations", "Suggests in-stock products that fit the shopper’s needs and budget."],
  [I.cart, "Add to cart from chat", "The right size, color, and quantity, straight into the real cart."],
  [I.ticket, "Coupons in chat", "Applies a coupon code the moment a shopper mentions it."],
  [I.mic, "Voice shopping", "Shoppers hold to speak and hear a natural voice reply."],
  [I.chat, "Answers day and night", "Shipping, returns, and product questions, answered from your own policies."],
  [I.box, "Order tracking", "Signed-in customers can check their order status in the chat."],
  [I.users, "Human Handover", "Shoppers can ask for a real person, and your team replies in the same chat.", "Professional and Agency"],
  [I.chart, "Full analytics with export", "See what shoppers ask for, and export the data."],
  [I.sliders, "Setup and customization", "Your agent’s name, voice, colors, and greeting, with no code."],
];

const versus = {
  life: ["Pay CartPilot once", "Use your own AI provider key", "Pay your provider for what you use", "WooCommerce stores only"],
  lifeBest: "owners who want control and a predictable platform cost",
  sub: ["Pay monthly or yearly", "No AI key needed. Conversations are included", "The AI cost is part of your plan", "Works on WooCommerce and Shopify"],
  subBest: "stores that want to start quickly with less setup",
};

// "A salesperson that gets things done": six action chips around a chat widget; each chip plays its own short conversation
const CART = svg(I.cart, "2");
const prod = (name: string, meta: string) => `<div class="lprod"><i></i><b>${name}</b><small>${meta}</small><span class="lprod__btns"><span>View Details</span><em>${CART}Add to Cart</em></span></div>`;
const me = (t: string) => `<span class="lm lm--me">${t}</span>`;
const ai = (t: string) => `<span class="lm lm--ai">${t}</span>`;
const yes = `<span class="lyes">${CHECK}</span>`, no = `<span class="lno">–</span>`;
const actions = [
  { ico: I.search, t: "Find a Product",
    chat: me("A black hoodie under $60 in size L?") + ai("Here are two that fit, both in stock in L.") + `<div class="lprods">${prod("Everyday Hoodie", "Black · L · $49.00")}${prod("Weekend Hoodie", "Black · L · $59.00")}</div>` },
  { ico: I.layers, t: "Compare Two Options",
    chat: me("What’s the difference between these two?") + ai("Here’s a quick side-by-side.") +
      `<div class="lcmp"><span></span><b>Everyday</b><b>Weekend</b><span>Price</span><span class="lcmp__v">$49.00</span><span class="lcmp__v">$59.00</span><span>Fleece lined</span>${no}${yes}<span>Under $60</span>${yes}${yes}<span>Size L in stock</span>${yes}${yes}</div>` },
  { ico: I.bag, t: "Add to Cart",
    chat: me("Add the Weekend Hoodie in black, size L.") + ai("Done. It’s in your cart.") +
      `<div class="lcart"><i></i><span><b>Weekend Hoodie</b><small>Black / L · Qty 1</small></span><strong>$59.00</strong></div><div class="lcart__f"><em>Checkout</em></div>` },
  { ico: I.ticket, t: "Apply a Coupon",
    chat: me("I have a code: SAVE10") + ai("Applied. You saved 10%.") +
      `<div class="lsum"><div><span>Subtotal</span><span><s>$59.00</s> <b>$53.10</b></span></div><div><span>Coupon SAVE10</span><span class="lsum__off">−10%</span></div></div>` },
  { ico: I.box, t: "Track an Order",
    chat: me("Where’s my order #1042?") + ai("It shipped yesterday and should arrive Friday.") +
      `<ol class="ltrack"><li class="is-done">${CHECK}Ordered</li><li class="is-done">${CHECK}Shipped</li><li><i>3</i>Arrives Friday</li></ol>` },
  { ico: I.mic, t: "Talk by Voice",
    chat: `<span class="lm lm--me lm--voice">${svg(I.mic, "2")}<span class="lwave">${[6,12,18,10,22,14,8,16,20,12,8,14,10,6].map((h) => `<i style="height:${h}px"></i>`).join("")}</span><small>0:04</small></span>` +
      ai("Here’s the Trail Runner in your size.") + `<div class="lprods lprods--one">${prod("Trail Runner", "Grey · 9 · $74.00")}</div>` },
];

const BYOK = "Unlimited conversations with your own AI key";
const plans = [
  { name: "Starter", desc: "Best for one store that wants a fixed cost", was: "$199", amt: "$139", plan: "cp-starter-ltd",
    feats: ["1 Shop", "10 conversations/month included", BYOK, "Unlimited products", "Unlimited training items", "Voice Agent", "Full Analytics + Export", "Priority Support", "Product updates"] },
  { name: "Professional", desc: "Best for up to 5 stores, with Human Handover", was: "$399", amt: "$279", plan: "cp-professional-ltd", pick: true,
    feats: ["5 Shops", "20 conversations/month included", BYOK, "Unlimited products", "Unlimited training items", "Voice Agent", "Human Handover", "Full Analytics + Export", "Priority Support", "Product updates"] },
  { name: "Agency", desc: "Best for agencies running many client stores", was: "$699", amt: "$489", plan: "cp-agency-ltd",
    feats: ["20 Shops", "50 conversations/month included", BYOK, "Unlimited products", "Unlimited training items", "Voice Agent", "Human Handover", "Full Analytics + Export", "Priority Support", "Product updates"] },
];

const faq = {
  chip: "Lifetime FAQ",
  title: "A Few Good Questions",
  lead: "Curious about something else? Our team is just a conversation away.",
  button: { href: "/contact/", label: "Talk to a Real Person" },
  items: [
    { q: "Which AI providers work with CartPilot?", a: "<p>Tell us which provider you use before you buy, and we’ll confirm it works with CartPilot.</p>" },
    { q: "Can I use CartPilot before I add my own key?", a: "<p>Yes. Each plan includes a set number of conversations every month: 10 on Starter, 20 on Professional, and 50 on Agency. Add your own AI key whenever you want unlimited conversations.</p>" },
    { q: "What happens if my AI key runs out of credit?", a: "<p>Top up your account with your AI provider, and CartPilot carries on. Your Lifetime plan itself never expires.</p>" },
    { q: "Are updates included?", a: "<p>Yes. Lifetime plans include product updates.</p>" },
    { q: "How do refunds work?", a: "<p>Every Lifetime plan has a 7-day money-back guarantee, no questions asked. If it isn’t right for you, contact our team within 7 days of buying.</p>" },
    { q: "Can I get Lifetime for a Shopify store?", a: "<p>No. Lifetime plans are for WooCommerce stores only. On Shopify, you can start free with the CartPilot app and move to a monthly or annual plan when you’re ready. <a href=\"/shopify/\">See CartPilot for Shopify →</a></p>" },
  ],
};
---
<Base title={title} description={description} bodyClass="lifetime-page header-page" fontWeights="400;500;600;700">
<Fragment slot="head">
  <style is:inline>
    /* ---------- Lifetime deal ---------- */
    .lifetime-page { --life: linear-gradient(90deg, #0054ff, #7b3cff 55%, #e2489c); --life-v: #7b3cff; }
    .lhead { max-width: 900px; margin-inline: auto; text-align: center; }
    .lhead h2 { text-wrap: balance; }
    .lhead p { margin-top: 20px; font-size: var(--fs-lead); line-height: 1.5; color: #6b7280; text-wrap: balance; }
    .lwrap { max-width: 1180px; margin-inline: auto; }

    /* Hero: dark, violet "mist" behind the floating header, with a lifetime licence card */
    body.header-page { --header-bg: #f6f6f6; }   /* header shares the off-white hero band (no white strip), same as /pricing/ */
    .lhero { position: relative; background: #f6f6f6; padding: clamp(56px, 6.67vw, 80px) 0 var(--section); }
    .lhero__in { display: flex; flex-direction: column; align-items: center; text-align: center; }
    .lhero .pill { background: #fff; border: 1px solid #ececef; color: var(--ink); }
    .lhero .pill img { width: auto; height: 12px; margin-right: 2px; }
    .lhero__woo { font-weight: 600; color: var(--blue); }
    .lhero h1 { margin-top: 20px; max-width: 1040px; text-wrap: balance; }
    .lhero h1 .lhero__l2 { display: block; }   /* second line, same ink as the first (no gradient) */
    .lhero__lead { margin-top: 28px; max-width: 760px; font-size: var(--fs-lead); line-height: 1.5; color: #4b5563; }
    .lhero .btn-row { margin-top: 40px; justify-content: center; }
    .loffer { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px 14px; margin-top: 24px; font-size: 16px; color: #4b5563; }
    .loffer__deal { padding: 6px 12px; border-radius: 99px; background: #16a34a; font-family: var(--font); font-size: 13px; font-weight: 600; line-height: 1; color: #fff; }
    .loffer i { width: 4px; height: 4px; border-radius: 50%; background: #cbd5e1; }
    .lhero__note { margin-top: 20px; font-size: 16px; color: #6b7280; }
    .lhero__note a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgb(15 23 42 / .3); transition: text-decoration-color .2s; }
    .lhero__note a:hover { text-decoration-color: var(--ink); }


    /* Who it's for */
    .laud__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-top: 56px; }
    .lcard { min-height: 300px; padding: 40px; border-radius: 10px; background: #f4f4f5; display: flex; flex-direction: column; justify-content: flex-start; gap: 40px; transition: background-color .35s var(--ease); }   /* titles line up across the row */
    .lcard__ico { width: 72px; height: 72px; border-radius: 50%; display: grid; place-items: center; transition: background-color .35s var(--ease), color .35s var(--ease); }
    .lcard__ico svg { width: 32px; height: 32px; }
    .lcard--blue .lcard__ico { background: #e1eaff; color: #0054ff; }
    .lcard--violet .lcard__ico { background: #ece4ff; color: #6b2fd6; }
    .lcard--pink .lcard__ico { background: #fde4f1; color: #c2367f; }
    .lcard h3 { font-size: var(--fs-h6); line-height: 1.3; color: #18181b; transition: color .35s var(--ease); }
    .lcard p { margin-top: 14px; font-size: var(--fs-lead); line-height: 1.5; color: #828282; transition: color .35s var(--ease); }
    .lcard:hover { background: #0e0e12; }   /* hover = dark mode, no lift (same as the home comparison cards) */
    .lcard:hover h3 { color: #fff; }
    .lcard:hover p { color: rgb(255 255 255 / .62); }
    .lcard:hover .lcard__ico { background: rgb(255 255 255 / .1); color: #fff; }
    .laud__more { display: flex; justify-content: center; margin-top: 40px; }

    /* Three steps: gradient rings on a dotted zigzag (same build as the platform pages) */
    .lsteps { background: #f4f4f5; }
    .lsteps__zz { position: relative; margin-top: 64px; }
    .lsteps__path { position: absolute; left: 0; top: 0; width: 100%; height: 220px; color: #b9a3f5; pointer-events: none; }
    .lsteps__grid { position: relative; list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
    .lstep { display: flex; flex-direction: column; align-items: center; text-align: center; }
    .lstep:nth-child(2) { padding-top: 110px; }
    .lstep__ring { position: relative; width: 120px; height: 120px; flex: none; border-radius: 50%; display: grid; place-items: center;
      background: conic-gradient(from 200deg, #9ec0ff, #0054ff, #7b3cff, #e2489c, #9ec0ff); }
    .lstep__ring > span { width: 104px; height: 104px; border-radius: 50%; display: grid; place-items: center; background: #fff; color: var(--life-v); }
    .lstep__ring svg { width: 36px; height: 36px; }
    .lstep__ring b { position: absolute; right: 2px; top: 2px; width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: #101014; color: #fff; font-size: 14px; font-weight: 600; }
    .lstep h3 { margin-top: 22px; font-size: var(--fs-h6); line-height: 1.3; }
    .lstep p { margin-top: 12px; max-width: 340px; font-size: var(--fs-lead); line-height: 1.55; color: #6b7280; }
    /* who pays for what: soft primary card, like the notes on the home and platform pages */
    .lbill { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 16px; width: fit-content; max-width: 100%; margin: 56px auto 0; padding: 20px 28px; border-radius: 10px; background: rgb(0 84 255 / .1); }
    .lbill__item { display: inline-flex; align-items: center; gap: 12px; padding: 10px 18px 10px 10px; border-radius: 99px; background: #fff; box-shadow: 0 0 0 1px #e3e9f8; }
    .lbill__item > span:first-child { width: 36px; height: 36px; flex: none; border-radius: 50%; display: grid; place-items: center; }
    .lbill__item img { width: 36px; height: 36px; border-radius: 50%; }
    .lbill__ai { background: #ece4ff; color: #6b2fd6; }
    .lbill__ai svg { width: 18px; height: 18px; }
    .lbill__item b { font-family: var(--font); font-size: 16px; font-weight: 600; color: var(--ink); }
    .lbill__item em { margin-left: 2px; padding-left: 12px; border-left: 1px solid #e5e7eb; font-style: normal; font-size: 16px; color: #6b7280; }
    .lbill__plus { font-size: 22px; font-weight: 500; color: #6b7280; }

    /* Everything included */
    /* dark band: solid background; rows fill with the primary blue on hover */
    .lfeat { background: #07070b; }
    .lfeat .lhead h2 { color: #fff; }
    .lfeat .lhead p { color: rgb(255 255 255 / .6); }
    .lfeat__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 56px; list-style: none; }
    .lfi { display: flex; align-items: center; gap: 16px; min-height: 96px; padding: 18px 22px 18px 18px; border-radius: 10px; border: 1px solid #222228; background: #121217; transition: border-color .3s var(--ease), background-color .3s var(--ease), box-shadow .3s var(--ease); }
    .lfi:hover { border-color: var(--blue); background: var(--blue); box-shadow: 0 20px 40px -22px rgb(0 84 255 / .7); }
    .lfi:hover .lfi__ico { background: rgb(255 255 255 / .18); color: #fff; }
    .lfi:hover .lfi__t small { color: rgb(255 255 255 / .78); }
    .lfi:hover .lfi__ok { background: #fff; color: #000; }
    .lfi__ico { width: 48px; height: 48px; flex: none; border-radius: 50%; display: grid; place-items: center; background: rgb(0 84 255 / .18); color: #8fb0ff; transition: background-color .3s var(--ease), color .3s var(--ease); }
    .lfi__ico svg { width: 22px; height: 22px; }
    .lfi__t { flex: 1; min-width: 0; color: #fff; }
    .lfi__t b { display: block; font-family: var(--font); font-size: 18px; font-weight: 500; line-height: 1.35; }
    .lfi__tier { display: inline-block; margin-left: 8px; padding: 4px 9px; border-radius: 99px; background: #faedcd; font-family: var(--font); font-size: 12px; font-weight: 500; font-style: normal; line-height: 1; color: #8a5a00; vertical-align: 2px; }
    .lfi__t small { display: block; margin-top: 4px; font-family: var(--font-text); font-size: 15px; font-weight: 400; line-height: 1.45; color: rgb(255 255 255 / .55); transition: color .3s var(--ease); }
    .lfi__ok { width: 28px; height: 28px; flex: none; border-radius: 50%; display: grid; place-items: center; background: rgb(255 255 255 / .1); color: #e4e4e7; transition: background-color .3s var(--ease), color .3s var(--ease); }
    .lfi__ok svg { width: 14px; height: 14px; }

    /* Lifetime or subscription */
    .lvs { background: #f4f4f5; }
    .lvs__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 56px; }
    .lvs__card { position: relative; isolation: isolate; overflow: hidden; display: flex; flex-direction: column; align-items: flex-start; padding: 48px; border-radius: 10px; background: #fff; }
    .lvs__card--life { background: radial-gradient(90% 70% at 100% 0%, rgb(123 60 255 / .38), transparent 62%), radial-gradient(70% 60% at 0% 100%, rgb(0 84 255 / .28), transparent 60%), #0c0b14; color: #fff; }
    .lvs__tag { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 99px; background: #f4f4f5; font-family: var(--font); font-size: 14px; font-weight: 500; color: #3f3f46; }
    .lvs__card--life .lvs__tag { background: rgb(255 255 255 / .08); border: 1px solid rgb(255 255 255 / .14); color: #fff; }
    .lvs__tag svg { width: 18px; height: 18px; }
    .lvs__card h3 { margin-top: 24px; font-size: var(--fs-h5); line-height: 1.25; }
    .lvs__card--life h3 { color: #fff; }
    .lvs__list { list-style: none; display: grid; gap: 14px; margin-top: 28px; margin-bottom: 40px; }
    .lvs__list li { display: flex; align-items: flex-start; gap: 12px; font-size: var(--fs-lead); line-height: 1.45; color: #4b5563; }
    .lvs__card--life .lvs__list li { color: rgb(255 255 255 / .78); }
    .lvs__list svg { width: 22px; height: 22px; flex: none; margin-top: 2px; padding: 4px; border-radius: 50%; background: #e1eaff; color: var(--blue); }
    .lvs__card--life .lvs__list svg { background: rgb(74 222 128 / .16); color: #4ade80; }
    .lvs__list { margin-bottom: 0; }
    .lvs__best { width: 100%; margin: 28px 0 36px; padding-top: 22px; border-top: 1px solid #ececef; font-size: 16px; line-height: 1.5; color: #6b7280; }
    .lvs__best b { font-family: var(--font); font-weight: 600; color: var(--ink); }
    .lvs__card--life .lvs__best { border-top-color: rgb(255 255 255 / .12); color: rgb(255 255 255 / .7); }
    .lvs__card--life .lvs__best b { color: #fff; }
    .lvs__card .btn { margin-top: auto; }
    .lvs__card--life .btn:not(.btn--secondary) { --bg-c: var(--blue); }

    /* Salesperson showcase: a chat widget on a photo with the six actions floating around it; each chip plays its conversation */
    .lshow { position: relative; isolation: isolate; overflow: hidden; background: #e9eef8; }
    .lshow__bg { position: absolute; inset: 0; z-index: -1;
      background: linear-gradient(180deg, rgb(255 255 255 / .92), rgb(255 255 255 / .6) 40%, rgb(255 255 255 / .55)), url("/assets/img/how/how-3.jpg") center / cover no-repeat; }
    .lhub { position: relative; height: 560px; margin-top: 40px; }
    .lhub__chips { list-style: none; }
    .lhub__chips li { position: absolute; translate: -50% -50%; }
    .lhub__chips li:nth-child(1) { left: 16%; top: 22%; } .lhub__chips li:nth-child(2) { left: 10%; top: 50%; } .lhub__chips li:nth-child(3) { left: 17%; top: 78%; }
    .lhub__chips li:nth-child(4) { left: 84%; top: 22%; } .lhub__chips li:nth-child(5) { left: 90%; top: 50%; } .lhub__chips li:nth-child(6) { left: 83%; top: 78%; }
    .lchip { display: inline-flex; align-items: center; gap: 10px; width: max-content; padding: 12px 20px 12px 12px; border-radius: 99px; background: rgb(255 255 255 / .92);
      -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); box-shadow: 0 20px 40px -18px rgb(15 23 42 / .45); font-family: var(--font); font-size: 16px; font-weight: 600; color: var(--ink);
      transition: box-shadow .3s var(--ease), transform .3s var(--ease); }
    .lchip:hover { transform: translateY(-2px); }
    .lchip__ico { width: 36px; height: 36px; flex: none; border-radius: 50%; display: grid; place-items: center; background: #eef3ff; color: var(--blue); transition: background-color .3s var(--ease), color .3s var(--ease); }
    .lchip__ico svg { width: 18px; height: 18px; }
    .lchip.is-on { box-shadow: 0 0 0 2px var(--blue), 0 20px 40px -18px rgb(0 84 255 / .55); }
    .lchip.is-on .lchip__ico { background: var(--blue); color: #fff; }
    .lwid { position: absolute; left: 50%; top: 50%; width: 400px; translate: -50% -50%; border-radius: 10px; overflow: hidden; background: #fff; box-shadow: 0 60px 120px -40px rgb(15 23 42 / .6); text-align: left; }
    .lwid__h { display: flex; align-items: center; gap: 10px; padding: 14px 16px; background: var(--blue); color: #fff; }
    .lwid__h img { width: 34px; height: 34px; border-radius: 50%; background: #fff; padding: 4px; }
    .lwid__h b { display: block; font-family: var(--font); font-size: 15px; font-weight: 600; }
    .lwid__h small { display: block; font-size: 12px; opacity: .8; }
    .lwid__b { position: relative; height: 312px; background: #f7f8fb; }
    .lwid__pane { position: absolute; inset: 0; display: flex; flex-direction: column; gap: 10px; padding: 16px; opacity: 0; transform: translateY(8px); transition: opacity .45s var(--ease), transform .45s var(--ease); pointer-events: none; }
    .lwid__pane.is-on { opacity: 1; transform: none; pointer-events: auto; }
    .lm { max-width: 85%; padding: 10px 14px; border-radius: 10px; font-size: 14px; line-height: 1.45; }
    .lm--me { align-self: flex-end; background: var(--blue); color: #fff; }
    .lm--ai { align-self: flex-start; background: #fff; color: var(--ink); box-shadow: 0 0 0 1px #eceef3; }
    .lm--voice { display: inline-flex; align-items: center; gap: 10px; }
    .lm--voice > svg { width: 16px; height: 16px; }
    .lm--voice small { font-size: 12px; opacity: .8; }
    .lwave { display: inline-flex; align-items: center; gap: 3px; height: 22px; }
    .lwave i { width: 3px; border-radius: 2px; background: rgb(255 255 255 / .85); }
    .lprods { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .lprods--one { grid-template-columns: minmax(0, 200px); }
    .lprod { display: grid; grid-template-columns: 40px 1fr; column-gap: 10px; align-items: center; padding: 8px; border-radius: 8px; background: #fff; box-shadow: 0 0 0 1px #eceef3; }
    .lprod i, .lcart i { grid-row: span 2; width: 40px; height: 40px; border-radius: 8px; background: linear-gradient(135deg, #1f2937, #4b5563); }
    .lprod b { font-family: var(--font); font-size: 12.5px; font-weight: 600; color: var(--ink); }
    .lprod small { font-size: 12.5px; color: #6b7280; }
    .lprod__btns { grid-column: 1 / -1; display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 6px; margin-top: 8px; }
    .lprod__btns > span { font-family: var(--font); font-size: 11px; color: #6b7280; text-decoration: underline; text-underline-offset: 2px; }
    .lprod em { display: inline-flex; align-items: center; justify-content: center; gap: 4px; padding: 6px 4px; border-radius: 6px; border: 1px solid #bfd1ff; font-style: normal; font-family: var(--font); font-size: 11px; white-space: nowrap; color: var(--blue); }
    .lprod em svg { width: 12px; height: 12px; }
    .lcmp { display: grid; grid-template-columns: 1fr 72px 72px; align-items: center; row-gap: 8px; padding: 12px 14px; border-radius: 8px; background: #fff; box-shadow: 0 0 0 1px #eceef3; font-size: 13px; color: #4b5563; }
    .lcmp b { font-family: var(--font); font-size: 12.5px; font-weight: 600; color: var(--ink); text-align: center; }
    .lcmp__v { text-align: center; font-family: var(--font); font-size: 12.5px; color: var(--ink); }
    .lyes, .lno { justify-self: center; width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center; }
    .lyes { background: #dcfce7; color: #16a34a; } .lyes svg { width: 11px; height: 11px; }
    .lno { color: #9ca3af; }
    .lcart { display: grid; grid-template-columns: 40px 1fr auto; column-gap: 10px; align-items: center; padding: 10px; border-radius: 8px; background: #fff; box-shadow: 0 0 0 1px #eceef3; }
    .lcart b { display: block; font-family: var(--font); font-size: 13px; font-weight: 600; color: var(--ink); }
    .lcart small { font-size: 12.5px; color: #6b7280; }
    .lcart strong { font-family: var(--font); font-size: 14px; font-weight: 600; color: var(--ink); }
    .lcart__f { display: flex; align-items: center; justify-content: flex-end; font-family: var(--font); font-size: 12.5px; color: #4b5563; }
    .lcart__f span { display: inline-flex; align-items: center; gap: 6px; }
    .lcart__f svg { width: 14px; height: 14px; color: #16a34a; }
    .lcart__f em { padding: 7px 14px; border-radius: 99px; background: var(--blue); color: #fff; font-style: normal; font-weight: 500; }
    .lsum { display: grid; gap: 8px; padding: 12px 14px; border-radius: 8px; background: #fff; box-shadow: 0 0 0 1px #eceef3; font-size: 13px; color: #4b5563; }
    .lsum div { display: flex; align-items: center; justify-content: space-between; }
    .lsum s { color: #9ca3af; }
    .lsum b { font-family: var(--font); font-size: 15px; font-weight: 600; color: var(--ink); }
    .lsum__off { font-family: var(--font); font-weight: 600; color: #16a34a; }
    .ltotal { display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; border-radius: 8px; background: #fff; box-shadow: 0 0 0 1px #eceef3; }
    .lcoupon { display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; border-radius: 99px; background: #dcfce7; color: #15803d; font-family: var(--font); font-size: 12px; font-weight: 600; }
    .lcoupon svg { width: 13px; height: 13px; }
    .ltotal__p s { margin-right: 8px; font-size: 13px; color: #9ca3af; }
    .ltotal__p b { font-family: var(--font); font-size: 18px; font-weight: 600; color: var(--ink); }
    .ltrack { list-style: none; display: grid; gap: 10px; padding: 12px 14px; border-radius: 8px; background: #fff; box-shadow: 0 0 0 1px #eceef3; font-family: var(--font); font-size: 13px; color: #6b7280; }
    .ltrack li { display: flex; align-items: center; gap: 10px; }
    .ltrack svg, .ltrack i { width: 20px; height: 20px; flex: none; border-radius: 50%; }
    .ltrack svg { padding: 4px; background: var(--blue); color: #fff; }
    .ltrack i { display: grid; place-items: center; box-shadow: inset 0 0 0 2px #cbd5e1; font-style: normal; font-size: 11px; font-weight: 600; color: #6b7280; }
    .ltrack .is-done { color: var(--ink); font-weight: 500; }
    .lwid__in { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-top: 1px solid #eceef3; font-size: 13px; color: #9ca3af; }
    .lwid__in i { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: var(--blue); color: #fff; }
    .lwid__in svg { width: 14px; height: 14px; }
    .lshow__cap { margin-top: 24px; text-align: center; font-size: 16px; color: #374151; }
    /* under 1100px the chips leave the orbit: a centred row above the widget */
    @media (max-width: 1100px) {
      .lhub { height: auto; display: flex; flex-direction: column; align-items: center; gap: 28px; }
      .lhub__chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; max-width: 760px; }
      .lhub__chips li { position: static; translate: none; }
      .lwid { position: relative; left: auto; top: auto; translate: none; width: min(400px, 100%); }
    }
    /* Plans */
    .lplans { position: relative; margin-top: 96px; scroll-margin-top: 24px; }
    .lplans__head { margin-bottom: 48px; }
    .lplans__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; align-items: stretch; }
    .lplan { position: relative; display: flex; flex-direction: column; padding: 40px; border-radius: 10px; background: #fff; border: 1px solid #e9e9e9; }
    .lplan--pick { border: 1.5px solid transparent; background: linear-gradient(#fff, #fff) padding-box, var(--life) border-box; }
    .lplan__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .lplan__head h3 { font-size: var(--fs-h6); line-height: 1.3; }
    .lplan__tag { padding: 6px 12px; border-radius: 45px; background: #faedcd; font-family: var(--font); font-size: 14px; font-weight: 500; line-height: 1.3; color: #8a5a00; }   /* same cream tag as /pricing/ */
    .lplan__desc { margin-top: 10px; min-height: 3em; font-size: 16px; line-height: 1.5; color: var(--text); }   /* two lines, so the prices line up */
    .lplan__was { display: flex; align-items: center; gap: 12px; margin-top: 28px; }
    .lplan__was s { font-size: 20px; line-height: 30px; color: var(--muted); }
    .lplan__off { padding: 6px 12px; border-radius: 25px; background: #d6f1a2; font-size: 14px; line-height: 18.2px; color: var(--text); }
    .lplan__price { display: flex; align-items: flex-end; gap: 8px; margin-top: 8px; }
    .lplan__amt { font-family: var(--font); font-size: var(--fs-h2); font-weight: 500; line-height: 1.1; color: var(--ink); }
    .lplan__per { padding-bottom: 8px; font-size: 16px; color: var(--text); }
    .lplan .btn { width: 100%; min-height: 61px; margin-top: 32px; }
    .lplan__flab { margin-top: 32px; padding-top: 28px; border-top: 1px solid #f0f0f2; font-family: var(--font); font-size: 16px; font-weight: 600; color: var(--ink); }
    .lplan__feats { list-style: none; display: grid; gap: 12px; margin-top: 18px; }
    .lplan__feats li { display: flex; align-items: flex-start; gap: 10px; font-size: 16px; line-height: 1.5; color: #4b5563; }
    .lplan__feats li:first-child { color: var(--ink); }
    .lplan__feats .lplan__byok { color: var(--ink); font-weight: 700; }
    .lplan__feats svg { width: 20px; height: 20px; flex: none; margin-top: 2px; padding: 4px; border-radius: 50%; background: #ececec; color: #000; }   /* same tick as the /pricing/ plan lists */
    .lplan__feats .lplan__byok svg { background: var(--blue); color: #fff; }   /* the bring-your-own-key line gets a key */
    .lplans__guard { display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 32px; font-size: 16px; color: #4b5563; text-align: left; }
    .lplans__guard b { font-family: var(--font); font-weight: 600; color: var(--ink); }
    .lplans__guard svg { width: 22px; height: 22px; flex: none; color: #16a34a; }
    .lnote { display: flex; align-items: center; gap: 20px; width: fit-content; max-width: 860px; margin: 32px auto 0; padding: 28px 36px 28px 28px;
      border-radius: 10px; background: rgb(0 84 255 / .1); font-size: 16px; line-height: 1.55; color: #4b5563; text-align: left; }
    .lnote__ico { width: 48px; height: 48px; flex: none; border-radius: 50%; display: grid; place-items: center; background: #fff; color: var(--blue);
      box-shadow: 0 0 0 1px #e3e9f8, 0 6px 14px -8px rgb(0 84 255 / .5); }
    .lnote__ico svg { width: 22px; height: 22px; }
    .lnote strong { display: block; margin-bottom: 4px; font-family: var(--font); font-weight: 600; color: var(--ink); }
    .lnote > span:last-child { text-wrap: balance; }

    @media (max-width: 1024px) {
      .laud__grid { grid-template-columns: 1fr; }
      .lcard { min-height: 0; flex-direction: row; align-items: center; gap: 24px; padding: 28px; }
      .lplans__grid { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; }
    }
    @media (max-width: 781px) {
      .lsteps__path { display: none; }
      .lsteps__grid { grid-template-columns: 1fr; gap: 48px; }
      .lstep:nth-child(2) { padding-top: 0; }
      .lfeat__grid, .lvs__grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 640px) {
      .lhero { padding: 56px 0 64px; }
      .lplans { margin-top: 64px; }
