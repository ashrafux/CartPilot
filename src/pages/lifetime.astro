    .lplan__desc { margin-top: 10px; min-height: 3em; font-size: 16px; line-height: 1.5; color: var(--text); }   /* two lines, so the prices line up */
    .lplan__was { display: flex; align-items: center; gap: 12px; margin-top: 28px; }
    .lplan__was s { font-size: 20px; line-height: 30px; color: var(--muted); }
