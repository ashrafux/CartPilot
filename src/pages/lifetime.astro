      .lnote__ico svg { width: 19px; height: 19px; }
    }
  </style>
</Fragment>

<main id="main">
  <!-- Hero -->
  <section class="lhero">
    <div class="container lhero__in">
      <p class="pill"><img src="/assets/img/woo-logo.png" alt="" width="48" height="12"> Lifetime Deal · <b class="lhero__woo">WooCommerce</b></p>
      <h1 class="h1">Pay Once. <span class="lhero__l2">Bring Your Own AI Key.</span></h1>
      <p class="lhero__lead">Get CartPilot for your WooCommerce store with a single payment. Connect your own AI provider key, pay the provider directly for what you use, and never pay CartPilot a monthly fee.</p>
      <div class="btn-row"><a class="btn btn--lg" href="#plans">See Lifetime Plans</a></div>
      <p class="loffer"><span class="loffer__deal">October Deals</span><span>30% off every Lifetime plan</span><i aria-hidden="true"></i><span>7-day money-back guarantee</span></p>
      <p class="lhero__note">On Shopify? Lifetime is for WooCommerce stores, but you can <a href="/shopify/">start free with the Shopify app →</a></p>
    </div>

    <!-- Plans: inside the hero, on the same violet background -->
    <div class="container lwrap lplans" id="plans" role="region" aria-label="Lifetime plans">
      <div class="lhead lplans__head" data-reveal>
        <h2 class="h3">Choose Your Lifetime Plan</h2>
        <p>One payment, no renewals. Pick the plan that covers the number of stores you run.</p>
      </div>
      <div class="lplans__grid">
        {plans.map((p) => (
          <article class={p.pick ? "lplan lplan--pick" : "lplan"} data-reveal>
            <div class="lplan__head"><h3>{p.name}</h3>{p.pick && <span class="lplan__tag">Recommended</span>}</div>
            <p class="lplan__desc">{p.desc}</p>
            <p class="lplan__was"><s><span class="sr-only">Regular price </span>{p.was}</s><span class="lplan__off">30% OFF</span></p>
            <p class="lplan__price"><span class="lplan__amt">{p.amt}</span><span class="lplan__per">/one-time</span></p>
            <a class={p.pick ? "btn" : "btn btn--secondary"} href={`https://app.cartpilot.ai/get-started?plan=${p.plan}&coupon=CPLAUNCHOFFERLTD`}>Choose {p.name}</a>
            <p class="lplan__flab">Features</p>
            <ul class="lplan__feats">{p.feats.map((f) => f === BYOK
              ? <li class="lplan__byok"><Fragment set:html={svg(I.key, "2.4")} />{f}</li>
              : <li><Fragment set:html={CHECK} />{f}</li>)}</ul>
          </article>
        ))}
      </div>
      <p class="lplans__guard"><Fragment set:html={svg(I.shield)} /><span><b>7-day money-back guarantee.</b> If Lifetime isn’t right for you, ask for a refund within 7 days.</span></p>
      <p class="lnote"><span class="lnote__ico" aria-hidden="true"><Fragment set:html={svg(I.info)} /></span><span><strong>A quick note on AI costs</strong>Your AI provider bills you for usage. What you pay depends on the provider you pick and how many conversations your store has, so check their pricing before you choose Lifetime.</span></p>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="section laud">
    <div class="container lwrap">
      <div class="lhead" data-reveal>
        <h2 class="h3">Your Store. Your Key. Your Call.</h2>
        <p>Lifetime works best when you’d rather own your setup than rent it.</p>
      </div>
      <div class="laud__grid">
        {audience.map((a) => (
          <div class={`lcard lcard--${a.tone}`} data-reveal>
            <span class="lcard__ico"><Fragment set:html={svg(a.ico)} /></span>
            <div><h3>{a.t}</h3><p>{a.p}</p></div>
          </div>
        ))}
      </div>
      <div class="laud__more"><a class="btn btn--tertiary" href="/pricing/">Prefer not to manage an AI key? A monthly plan includes everything you need →</a></div>
    </div>
  </section>

  <!-- Three steps -->
  <section class="section lsteps">
    <div class="container lwrap">
      <div class="lhead" data-reveal>
        <h2 class="h3">Three Steps. Then It’s Yours.</h2>
        <p>You pay CartPilot once. Your AI provider bills you separately for usage, so you always know where your money goes.</p>
      </div>
      <div class="lsteps__zz">
        <svg class="lsteps__path" viewBox="0 0 1180 220" preserveAspectRatio="none" aria-hidden="true"><path d="M200 60 C 400 60, 400 170, 590 170 S 780 60, 980 60" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="6 8" vector-effect="non-scaling-stroke"/></svg>
