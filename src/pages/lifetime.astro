<Fragment slot="scripts">
<script is:inline src="/assets/js/hero-gradient.js?v=2" defer></script>
<script is:inline>
  /* "A salesperson that gets things done": pick an action to show its art. While the section is on screen it steps
     through the actions on its own until the visitor picks one; reduced motion keeps it still. */
  (() => {
    const box = document.querySelector("[data-show]");
    if (!box) return;
    const btns = [...box.querySelectorAll("[data-show-i]")];
    const imgs = [...box.querySelectorAll(".lshow__stage img")];
    let cur = 0, timer = 0, auto = !matchMedia("(prefers-reduced-motion: reduce)").matches;
    const show = (i) => {
      cur = i;
      btns.forEach((b, k) => { b.classList.toggle("is-on", k === i); b.setAttribute("aria-pressed", String(k === i)); });
      imgs.forEach((im, k) => { im.classList.toggle("is-on", k === i); im.alt = k === i ? btns[k].querySelector("b").textContent : ""; });
    };
    const stop = () => { auto = false; clearInterval(timer); };
    btns.forEach((b, i) => b.addEventListener("click", () => { stop(); show(i); }));
    if (auto) new IntersectionObserver(([e]) => {
      clearInterval(timer);
      if (e.isIntersecting && auto) timer = setInterval(() => show((cur + 1) % btns.length), 3800);
    }, { threshold: 0.35 }).observe(box);
  })();
</script>
</Fragment>
