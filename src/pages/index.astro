<Fragment slot="scripts">
<script is:inline>
  /* Hero orb: hold on the poster frame for reduced-motion users. */
  (() => {
    const v = document.querySelector(".hero__orb video");
    if (v && matchMedia("(prefers-reduced-motion: reduce)").matches) { v.removeAttribute("autoplay"); v.pause(); v.currentTime = 0; }
  })();

  /* Why CartPilot: pin the stage and carry the copy + cards right → left while it is pinned.
     The section is made exactly (stage height + travel) tall so the sticky stage releases
     the moment the last card reaches the content's right edge. Smoothed like a scrubbed tween. */
  (() => {
    const sec = document.getElementById("why");
    if (!sec) return;
    const stage = sec.querySelector(".dc__stage"), wrap = sec.querySelector(".container"), track = sec.querySelector(".dc__track");
    const mq = matchMedia("(min-width: 1024px) and (prefers-reduced-motion: no-preference)");
    let travel = 0, cur = 0, raf = 0, on = false;
    if (mq.matches) sec.classList.add("is-pinned");
    const dist = () => {
      const cs = getComputedStyle(wrap);
      return Math.max(0, track.offsetWidth - (wrap.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight)));
    };
    const off = () => { on = false; sec.classList.remove("is-pinned"); sec.style.height = ""; track.style.transform = ""; cur = 0; };
    const goal = () => Math.min(travel, Math.max(0, -sec.getBoundingClientRect().top));
    const tick = () => {
      cancelAnimationFrame(raf);
      const step = () => {
        if (!on) return;
        const t = goal();
        cur += (t - cur) * 0.14;
        if (Math.abs(t - cur) < 0.3) cur = t;
        track.style.transform = `translate3d(${-cur}px, 0, 0)`;
        if (cur !== t) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };
    const measure = () => {
      if (!mq.matches) return off();
      on = true;
      sec.classList.add("is-pinned");
      travel = dist();
      sec.style.height = stage.offsetHeight + travel + "px";
      cur = goal();
      tick();
    };
    addEventListener("scroll", () => on && tick(), { passive: true });
    addEventListener("resize", measure);
    mq.addEventListener("change", measure);
    (document.fonts ? document.fonts.ready : Promise.resolve()).then(measure);
    addEventListener("load", measure);
  })();
</script>
