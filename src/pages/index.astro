---
import Base from "../layouts/Base.astro";
import Faq from "../components/Faq.astro";
import CtaSky from "../components/CtaSky.astro";
const title = "CartPilot - Smart AI Sales Agent for eCommerce Stores";
const description = "CartPilot is a smart AI sales agent for WooCommerce and Shopify. Let shoppers talk or text to find products, compare options, add to cart, and track orders.";

const faq = {
  chip: "CartPilot FAQ",
  title: "Frequently Asked Questions",
  lead: "Find answers to common questions and learn how to get the most out of CartPilot.",
  button: { href: "/faq/", label: "Read All FAQs" },
  items: [
    { q: "Which platforms does CartPilot support?",
      a: "<p>CartPilot works with WooCommerce and Shopify, with more platforms on the way. On WooCommerce, install the WordPress plugin and connect your CartPilot account. On Shopify, install the app, and your account is set up automatically. Either way, you don’t need any custom development.</p>" },
    { q: "Can shoppers actually talk to the agent with their voice?",
      a: "<p>Yes. Shoppers can type or hold to speak, and CartPilot replies in a natural voice. You can pick from 30+ voices in your dashboard. Voice is included on all paid plans.</p>" },
    { q: "Will it actually add things to the cart, or just show products?",
      a: "<p>CartPilot actually manipulates your store’s cart. When a shopper says “add the blue one in size M,” CartPilot adds the correct product variant to their real cart. It can also update quantities and remove items – all without the shopper leaving the conversation or navigating anywhere.</p>" },
    { q: "How long does setup take? Do I need a developer?",
      a: "<p>No, you don’t need a developer. On WooCommerce, install the CartPilot plugin and connect your account. On Shopify, install the app, and your store connects automatically. CartPilot then syncs your products, prices, and stock on its own. Add your agent’s name, greeting, and colors, and you can go live within minutes.</p>" },
    { q: "Is my customer conversation data private and secure?",
      a: "<p>All CartPilot API calls between your store and our platform are authenticated using HMAC-SHA256 signature verification. Conversation logs are stored securely in your merchant dashboard. We take data privacy seriously and are building toward full GDPR compliance.</p>" }
  ],
};

const cta = {
  title: "Start Free. Upgrade When You’re Ready.",
  text: "CartPilot is the AI agent that talks, types, and closes – right from the chat window of your WooCommerce or Shopify store.",
};
---
<Base title={title} description={description} bodyClass="home theme-dark-hero" fontWeights="400;500;600;700">
<Fragment slot="head">
  <style is:inline>
    /* ---------- Home (copy v2) ---------- */
    .home { --bg-hero: #dbeafe; }
    /* Dark hero: animated "mist" WebGL gradient (assets/js/hero-gradient.js) behind the floating header */
    .hero { position: relative; isolation: isolate; background: #000; padding-top: calc(109px + 100px); overflow: hidden; color: #fff; }
    .hero__bg { position: absolute; inset: 0; z-index: -1; background: #000; }
    .hero__bg canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
    .hero .pill { background: rgb(255 255 255 / .08); border: 1px solid rgb(255 255 255 / .16); color: #e4e4e7; -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
    .hero h1 { color: #fff; }
    .hero .hero__lead { color: #a1a1aa; }
    .hero .btn:not(.btn--secondary) { --bg-c: var(--blue); --fg: #fff; }   /* dark hero: primary-blue pill, white badge with blue chevrons */
    .hero .btn:not(.btn--secondary):hover { --bg-c: #0046d4; }
    .hero .btn--secondary { --fg: #fff; --bd: rgb(255 255 255 / .32); }
    .hero .btn--secondary:hover { --bg-c: #fff; --fg: #101014; --bd: #fff; }
    .hero .btn--secondary img { filter: invert(1); }
    .hero .btn--secondary:hover img { filter: none; }
    .hero .works { color: #a1a1aa; }
    .hero .works a { color: #fff; }
    .hero .works a:hover { color: #fff; opacity: .85; }
    .hero__media > img { filter: drop-shadow(0 -20px 60px rgb(0 84 255 / .22)); }  /* pink version: rgb(255 102 184 / .18) */
    .hero__in { display: flex; flex-direction: column; align-items: center; text-align: center; }
    /* "Now live" tag + animated CartPilot orb (cropped from the reference recording; black bg drops out via screen blend) */
    .hero__tag { display: flex; align-items: center; justify-content: center; gap: 8px; }
    .pill__logo { width: 1.1em; height: 1.1em; margin: -.12em -1px 0; flex: none; }  /* the pill is a flex row (gap 6px), so the icon sits evenly between "on" and "Shopify" */
    .hero__orb { --h: 54px; position: relative; flex: none; width: var(--h); height: var(--h); margin-block: -7px; }  /* larger than the 41px pill; negative margin keeps the row height */
    .hero__orb video { position: absolute; left: 50%; top: 50%; width: 120%; height: 120%; translate: -50% -50%; }
    .hero__orb video { display: block; object-fit: cover; mix-blend-mode: screen; pointer-events: none;
      -webkit-mask-image: radial-gradient(circle closest-side, #000 86%, transparent); mask-image: radial-gradient(circle closest-side, #000 86%, transparent); }
    .hero h1 { margin-top: 20px; max-width: 1120px; text-wrap: balance; }
    .hero__lead { margin-top: 28px; max-width: 760px; }
    .hero .btn-row { margin-top: 56px; gap: 15px; }
    .hero .btn--secondary img { width: 15px; height: 18px; transition: transform .25s var(--ease); }
    .hero .btn--secondary:hover img { transform: scale(1.12); }
    .works { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 6px 20px; margin-top: 22px; font-size: 16px; color: var(--subtle); }
    .works a { display: inline-flex; align-items: center; gap: 7px; padding: 4px 0; color: var(--ink); font-weight: 500; transition: color .2s, transform .2s var(--ease); }
    .works a:hover { color: var(--blue-2); transform: translateY(-1px); }
    .works img { width: 22px; height: 22px; }
    .works img.works__woo { width: auto; height: 11px; margin-right: 2px; }
    /* Browser-frame screenshot sits flush on the hero's bottom edge */
    .hero__media { position: relative; width: 100%; margin-top: 130px; container-type: inline-size; }
    .hero__media > img { width: 100%; height: auto; display: block; }
    /* The screenshot's black device bezel was stripped (hero-browser.png = header image.png minus the 30px bezel);
       a 3px primary stroke now hugs the browser edge instead. Browser rect in the 2826×1694 image: inset 30, radius 46. */
    .hero__media::before { content: ""; position: absolute; z-index: 1; pointer-events: none; left: calc(30 / 2826 * 100% - 3px); right: calc(30 / 2826 * 100% - 3px); top: calc(30 / 1694 * 100% - 3px); bottom: 0;
      border: 3px solid var(--blue); border-bottom: 0; border-radius: calc(46 / 2826 * 100cqw + 3px) calc(46 / 2826 * 100cqw + 3px) 0 0; }
    .cart-chip {
      position: absolute; left: 46.8%; top: 27.6%;
      display: flex; align-items: center; gap: clamp(10px, 1.1cqw, 16px);
      padding: clamp(6px, .65cqw, 9px) clamp(18px, 2.4cqw, 34px) clamp(6px, .65cqw, 9px) clamp(6px, .65cqw, 9px);
      background: #fff; border-radius: 999px; box-shadow: 0 18px 40px -16px rgb(15 23 42 / .28), 0 2px 6px rgb(15 23 42 / .06);
      text-align: left; animation: chip-float 5s ease-in-out infinite;
    }
    .cart-chip__ico { width: clamp(40px, 4.6cqw, 64px); aspect-ratio: 1; border-radius: 50%; background: #dfeafe; color: var(--blue-2); display: grid; place-items: center; flex: none; }
    .cart-chip__ico svg { width: 46%; height: 46%; }
    .cart-chip small { display: block; font-size: clamp(12px, 1.18cqw, 16.5px); line-height: 1.3; color: var(--muted); }
    .cart-chip b { display: block; font-size: clamp(15px, 1.58cqw, 22px); line-height: 1.3; font-weight: 500; color: var(--ink); white-space: nowrap; }
    @keyframes chip-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }

    /* ---------- Problem: staggered stat cards on a faint grid ---------- */
    .problem { position: relative; overflow: hidden; }
    .problem__grid {
      --card: clamp(280px, 23.6vw, 340px); position: relative;
      display: grid; grid-template-columns: minmax(0, 1fr) repeat(3, var(--card)); column-gap: 24px; row-gap: 120px;
      grid-template-areas: "head head t1 t2" ". b1 b2 .";
    }
    .problem__grid::before {
      content: ""; position: absolute; inset: -144px -10% -144px -6%; z-index: -1; pointer-events: none;
      background-image: linear-gradient(to right, rgb(37 99 235 / .09) 1px, transparent 1px), linear-gradient(to bottom, rgb(37 99 235 / .09) 1px, transparent 1px);
      background-size: 116px 116px; background-position: -1px -1px;
      -webkit-mask-image: radial-gradient(ellipse 55% 60% at 32% 52%, #000 25%, transparent 78%);
              mask-image: radial-gradient(ellipse 55% 60% at 32% 52%, #000 25%, transparent 78%);
    }
    .problem__head { grid-area: head; align-self: start; max-width: 640px; }
    .problem__title { font-size: var(--fs-h3); line-height: 1.12; font-weight: var(--fw-heading); letter-spacing: -.02em; color: var(--ink); }
    .problem__title span { display: block; }
    .problem__title .hl { color: var(--blue-2); }
    .problem__title .dim { color: #a3acb9; }
    .problem__lead { margin-top: 24px; max-width: 540px; font-size: var(--fs-lead); color: var(--text); }
    .pcards { display: contents; }
    .pcard {
      position: relative; aspect-ratio: 1; border-radius: 10px; padding: 32px; container-type: inline-size;
      display: flex; flex-direction: column; justify-content: space-between; gap: 24px; overflow: hidden;
      transition: transform .35s var(--ease), opacity .7s var(--ease);
    }
    .pcard:nth-child(1) { grid-area: t1; }
    .pcard:nth-child(2) { grid-area: t2; }
    .pcard:nth-child(3) { grid-area: b1; }
    .pcard:nth-child(4) { grid-area: b2; }
    .pcard::before { content: ""; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 1px 0 rgb(255 255 255 / .7); pointer-events: none; }
    .pcard:hover { transform: translateY(-6px); }
    .pcard__num { font-size: min(20cqi, 64px); line-height: 1.05; letter-spacing: -.035em; font-weight: 500; color: #0b1220; }
    .pcard__num span { color: var(--dim); }
    .pcard__txt { font-size: 18px; line-height: 1.45; color: var(--txt); max-width: 250px; }
    .pcard--blue { --dim: #1e3a8a99; --txt: #0b1220; background: linear-gradient(180deg, #4f8ef7 0%, #93c2ff 100%); }
    .pcard--light { --dim: #7e9ccb; --txt: #4b5563; background: linear-gradient(180deg, #eef4ff 0%, #a9c8ff 100%); }
    .pcard--gray { --dim: #b8bcc4; --txt: #6b7280; background: linear-gradient(180deg, #fafafa 0%, #eeeff1 100%); border: 1px solid #e7e8eb; }

    /* ---------- Journey: ruled index list ---------- */
    .journey-sec { --rule: #e6e8ec; }
    /* 144px section padding above + 96px here = 240px from the stat cards to the heading */
    .jlist-head { text-align: center; padding: 96px 24px 52px; border-bottom: 1px solid var(--rule); }
    .jlist-title { max-width: 1200px; margin-inline: auto; font-family: var(--font); font-size: var(--fs-h3); line-height: 1.2; font-weight: var(--fw-heading); color: var(--ink); text-wrap: balance; }
    .jlist-title span { display: block; }
    .jlist-sub { max-width: 860px; margin: 24px auto 0; font-size: var(--fs-lead); line-height: 1.5; color: #6b7280; }
    .jlist { list-style: none; }
    .jrow { display: grid; grid-template-columns: 140px minmax(0, 1fr) auto; border-bottom: 1px solid var(--rule); transition: background-color .3s var(--ease); }
    .jrow > * { padding: 18px 40px; }
    .jrow__num { font-family: var(--font); font-size: clamp(26px, calc(12px + 1.6vw), 36px); line-height: 1.2; font-weight: 400; color: var(--ink); transition: color .3s var(--ease); }
    .jrow__body { display: flex; flex-direction: column; justify-content: space-between; gap: 16px; padding-inline: 40px; border-inline: 1px solid var(--rule); }
    .jrow__title { font-family: var(--font); font-size: var(--fs-card); line-height: 1.3; font-weight: var(--fw-heading); color: var(--ink); transition: color .3s var(--ease); }
    .jrow__desc { max-width: 560px; font-size: 16px; line-height: 1.5; color: #6b7280; }
    .jrow__media { display: flex; justify-content: flex-end; align-items: flex-start; }
    .jrow__media { padding-left: 64px !important; }
    /* art sits on #F3F3F3; the row's colourful ground fades in on hover (same UI, two renders) */
    .jrow__art { position: relative; display: block; width: 160px; border-radius: 10px; overflow: hidden; background: #f3f3f3; transition: transform .5s var(--ease), box-shadow .5s var(--ease); }
    .jrow__art img { display: block; width: 100%; height: auto; }
    .jrow__art img + img { position: absolute; inset: 0; opacity: 0; transition: opacity .45s var(--ease); }
    .jrow:hover .jrow__art img + img { opacity: 1; }
    .jrow:hover { background: #fafbff; }
    .jrow:hover :is(.jrow__num, .jrow__title) { color: var(--blue); }   /* number and title take the primary blue */
    /* hover: the thumbnail pops a little bigger and tilts slightly, lifted by a soft shadow */
    .jrow:hover .jrow__art { transform: scale(1.1) rotate(-3deg); box-shadow: 0 18px 34px -16px rgb(15 23 42 / .4); }
    @media (prefers-reduced-motion: reduce) { .jrow:hover .jrow__art { transform: scale(1.04); } }
    .jlist-foot { max-width: 640px; margin: 40px auto 0; text-align: center; font-size: 16px; line-height: 1.5; color: #6b7280; }

    /* ---------- Capabilities (Figma frame: #F4F4F5, 144px padding, 56px gap, 8px card gutters) ---------- */
    .caps { background: #f4f4f5; padding: var(--section) var(--gutter); }
    .caps__in { max-width: 1401px; margin-inline: auto; display: flex; flex-direction: column; gap: 56px; }
    .caps__head { display: flex; flex-direction: column; align-items: center; gap: 24px; text-align: center; }
    .caps__title { font-size: var(--fs-h3); line-height: 1.2; font-weight: var(--fw-heading); color: #000; }
    .caps__title span { display: block; }
    .caps__lead { max-width: 1010px; font-size: var(--fs-lead); line-height: 1.5; color: #6b7280; }
    .caps__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .caps__cta { justify-content: center; }
    .cap { position: relative; isolation: isolate; overflow: hidden; min-height: 285px; padding: 32px; border-radius: 10px; background: #fff; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 32px; }
    .cap__ico { width: 80px; height: 80px; border-radius: 50%; display: grid; place-items: center; flex: none; }
    .cap__ico svg { width: 40px; height: 40px; }
    .cap__text { display: flex; flex-direction: column; gap: 16px; position: relative; z-index: 1; }
    .cap__title { font-size: var(--fs-h6); line-height: 1.3; font-weight: var(--fw-heading); color: #18181b; }
    .cap__desc { font-size: var(--fs-body); line-height: 1.5; color: #828282; }

    /* ---------- Why CartPilot: sticky horizontal gallery (same motion as the Dokan "Whatever you want to sell" row) ----------
       Desktop: the stage sticks for (track width − content width) px of scroll and the copy + cards travel right → left.
       Below 1024px or with reduced motion it is a normal block: copy on top, cards in a swipe row. */
    .dc { position: relative; padding-block: 96px; }
    /* default (no pin: small screens, reduced motion, no JS): copy on top, cards in a swipe row */
    .dc__track { display: flex; flex-direction: column; gap: 40px; }
    .dc__title br { display: none; }
    .dc__title span { white-space: nowrap; }
    .dc__row { display: flex; gap: 17px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); scroll-padding-inline: var(--gutter); }
    .dc__row::-webkit-scrollbar { display: none; }
    /* pinned (desktop, motion allowed): the stage sticks and the whole row travels sideways */
    .dc.is-pinned { padding-block: 0; }
    .dc.is-pinned .dc__stage { position: sticky; top: 0; height: 100vh; min-height: 640px; display: flex; align-items: center; overflow: hidden; }
    .dc.is-pinned .dc__track { flex-direction: row; align-items: center; gap: 0; width: max-content; will-change: transform; }
    .dc.is-pinned .dc__copy { flex: 0 0 520px; padding-right: 64px; }
    .dc.is-pinned .dc__title br { display: inline; }
    .dc.is-pinned .dc__lead { max-width: 360px; margin-top: 32px; }
    .dc.is-pinned .dc__row { overflow: visible; margin: 0; padding: 0; }
    .dc__title { font-size: var(--fs-h3); line-height: 1.19; font-weight: 600; letter-spacing: -.02em; color: var(--ink); }
    .dc__lead { margin-top: 20px; max-width: 600px; font-size: var(--fs-lead); line-height: 1.6; color: #475569; }
    .dc__cta { margin: 24px 0 0 -8px; }
    .dc-card { position: relative; flex: 0 0 min(481px, 86%); height: 480px; scroll-snap-align: start; border-radius: 10px; overflow: hidden; display: flex; background-size: cover; background-position: center; transition: background-color .45s var(--ease); }
    .dc.is-pinned .dc-card { flex: 0 0 481px; height: clamp(460px, calc(100vh - 150px), 564px); }
    .dc-card__in { display: flex; flex-direction: column; align-items: flex-start; width: 100%; padding: 52px 48px; }
    .dc-card__title { max-width: 340px; font-size: clamp(28px, 2.4vw, 34px); line-height: 1.2; font-weight: 600; letter-spacing: -.02em; color: var(--ink); }
    .dc-card__body { margin-top: 18px; max-width: 370px; font-size: 18px; line-height: 1.55; color: #475569; }
    .dc-card__tag { margin-top: 18px; font-size: 15px; line-height: 1.4; font-weight: 600; color: var(--ink); }
    .dc-card__icon { margin-top: auto; width: 76px; height: 76px; color: var(--icon); transition: color .45s var(--ease); }
    .dc-card__icon svg { width: 100%; height: 100%; }
    /* hover: no lift — the card turns dark and the icon takes the card's own pastel */
    .dc-card__title, .dc-card__body, .dc-card__tag { transition: color .45s var(--ease); }
    .dc-card:not(.dc-card--photo):hover { background-color: #101014; }
    .dc-card:not(.dc-card--photo):hover :is(.dc-card__title, .dc-card__tag) { color: #fff; }
    .dc-card:not(.dc-card--photo):hover .dc-card__body { color: #a1a1aa; }
    .dc-card:not(.dc-card--photo):hover .dc-card__icon { color: var(--soft); }
    .dc-card--sand { background-color: #f8e8c8; --soft: #f8e8c8; --icon: #8a4b0f; }
    .dc-card--rose { background-color: #eae1e1; --soft: #eae1e1; --icon: #7a2e3f; }
    .dc-card--sky { background-color: #dfe9fb; --soft: #dfe9fb; --icon: #1e3a8a; }
    .dc-card--mint { background-color: #ddf1e5; --soft: #ddf1e5; --icon: #14532d; }
    .dc-card--photo::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(to top, rgb(10 10 16 / .78) 0%, rgb(10 10 16 / .45) 34%, rgb(10 10 16 / 0) 62%); }
    .dc-card--photo .dc-card__in { position: relative; z-index: 1; justify-content: flex-end; }
    .dc-card--photo .dc-card__title, .dc-card--photo .dc-card__tag { color: #fff; }
    .dc-card--photo .dc-card__body { color: rgb(255 255 255 / .9); }


    @media (max-width: 1023px) {
      .dc-card__in { padding: 40px 34px; }
    }
    @media (max-width: 1024px) {
      .hero { padding-top: calc(84px + 72px); }
    }
    @media (max-width: 1100px) {
      .jrow { grid-template-columns: 96px minmax(0, 1fr) auto; }
      .jrow__body { padding-inline: 28px; }
      .jrow__media { padding-left: 28px !important; }
      .jrow__art { width: 150px; }
      .jrow > * { padding: 16px 28px; }
      .jrow__desc { max-width: 420px; }
      .problem__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-areas: "head head" "t1 t2" "b1 b2"; row-gap: 24px; }
      .problem__head { align-self: start; margin-bottom: 32px; }
      .pcard { aspect-ratio: auto; min-height: 280px; }
      .pcard:nth-child(even) { translate: 0 48px; }
      .problem__grid { padding-bottom: 48px; }
    }
    @media (max-width: 600px) {
      .caps__grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 600px) {
      .dc { padding-block: 64px; }
      .dc-card { height: 460px; }
      .dc-card__in { padding: 32px 26px; }
      .dc-card__body { font-size: 16px; }
      .jlist-head { padding: 36px 16px 40px; }
      .jrow { grid-template-columns: minmax(0, 1fr); grid-template-areas: "num" "body" "media"; padding: 24px 0 28px; }
      .jrow > * { padding: 0; }
      .jrow__num { grid-area: num; font-size: 20px; color: var(--blue-2); }
      .jrow__body { grid-area: body; border: 0; padding: 10px 0 0; justify-content: flex-start; gap: 8px; }
      .jrow__title { font-size: 22px; }
      .jrow__desc { font-size: 14px; }
      .jrow__media { grid-area: media; }
      .jrow__media { padding: 16px 0 0 !important; justify-content: flex-start; }
      .jrow__art { width: 100%; max-width: none; }
      .jlist-foot { margin-top: 28px; }
      .hero { padding-top: calc(84px + 32px); }
      .hero__orb { --h: 46px; margin-block: -4px; }
      .hero__lead { margin-top: 20px; }
      .hero .btn-row { margin-top: 36px; }
      .hero__media { margin-top: 48px; }
      .cart-chip { display: none; }
      .problem__grid { grid-template-columns: 1fr; grid-template-areas: "head" "t1" "t2" "b1" "b2"; row-gap: 16px; padding-bottom: 0; }
      .pcard:nth-child(even) { translate: none; }
      .pcard { min-height: 220px; padding: 26px; }
      .pcard__num { font-size: min(16cqi, 52px); }
      .cap { min-height: 0; padding: 28px 22px; gap: 24px; }
      .cap__ico { width: 64px; height: 64px; }
      .cap__ico svg { width: 32px; height: 32px; }
      .caps__in { gap: 40px; }
      .caps__cta { flex-direction: column; align-items: stretch; width: 100%; max-width: 340px; margin-inline: auto; }
    }
  </style>
</Fragment>

<main id="main">
  <!-- Hero -->
  <section class="hero">
    <div class="hero__bg" data-mist data-speed="0.6" data-opacity="0.8" data-color="#0054ff" data-highlight="#5b8cff" data-glow="#8db8ff" aria-hidden="true"><canvas></canvas></div>
    <div class="container hero__in">
      <div class="hero__tag">
        <p class="pill">Now live on <img class="pill__logo" src="/assets/icons/shopify.svg" alt="" width="18" height="18">Shopify</p>
        <span class="hero__orb" aria-hidden="true"><video src="/assets/video/cartpilot-orb.mp4" poster="/assets/img/cartpilot-orb.jpg" autoplay muted loop playsinline preload="auto" disablepictureinpicture></video></span>
      </div>
      <h1 class="h1">Your Store’s AI Salesperson That Never Clocks Out</h1>
