<Fragment slot="scripts">
<script is:inline>
  /* Docs page: doc actions, quick search, tree toggle, TOC scroll-spy, font size, helpful vote, print, reading progress */
  (() => {
    const $ = (s, el = document) => el.querySelector(s);
    const $$ = (s, el = document) => [...el.querySelectorAll(s)];
    const store = {
      get(k) { try { return localStorage.getItem(k); } catch { return null; } },
      set(k, v) { try { localStorage.setItem(k, v); } catch {} },
    };
    const local = /^(localhost|127\.|\[::1\]|0\.0\.0\.0)|\.(localhost|test)$/.test(location.hostname) || location.protocol === "file:";
    const pageUrl = local ? "https://cartpilot.ai/docs/" : location.href.split("#")[0];
    const docTitle = document.title;
    const article = $("[data-doc-article]");
    const body = $("[data-doc-body]");
    const live = $("[data-doc-live]");

    // Keep share links pointing at the real page URL once deployed.
    if (!local) {
      const u = encodeURIComponent(pageUrl);
      const map = {
        facebook: `https://www.facebook.com/sharer/sharer.php?u=${u}`,
        x: `https://twitter.com/intent/tweet?url=${u}&text=CartPilot`,
        linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`,
        pinterest: `https://pinterest.com/pin/create/button/?url=${u}&description=CartPilot`,
      };
      $$("[data-share]").forEach((a) => (a.href = map[a.dataset.share]));
    }

    /* ---------- Markdown export of the article ---------- */
    const abs = (href) => new URL(href, pageUrl).href;
    const inline = (el) => [...el.childNodes].map((n) => {
      if (n.nodeType === 3) return n.textContent;
      if (n.nodeType !== 1 || n.getAttribute("aria-hidden") === "true") return "";
      if (n.tagName === "A") return `[${n.textContent.trim()}](${abs(n.getAttribute("href"))})`;
      if (n.tagName === "STRONG" || n.tagName === "B") return `**${inline(n)}**`;
      if (n.tagName === "EM" || n.tagName === "I") return `*${inline(n)}*`;
      return inline(n);
    }).join("").replace(/\s+/g, " ").trim();
    const toMarkdown = () => {
      const out = [`# ${docTitle}`, `Source: ${pageUrl}`, "---"];
      [...body.children].forEach((el) => {
        if (el.hasAttribute("data-md-skip")) return;
        const t = el.tagName;
        if (t === "H2") out.push(`## ${el.textContent.trim()}`);
        else if (t === "H3") out.push(`### ${el.textContent.trim()}`);
        else if (t === "P") out.push(inline(el));
        else if (t === "UL") out.push($$("li", el).map((li) => `- ${inline(li)}`).join("\n"));
        else if (t === "OL") out.push($$("li", el).map((li, i) => `${i + 1}. ${inline(li)}`).join("\n"));
        else if (el.classList.contains("btn-row")) $$("a", el).forEach((a) => out.push(`[${a.textContent.trim()}](${abs(a.getAttribute("href"))})`));
      });
      return out.join("\n\n") + "\n";
    };
    const copyText = async (text) => {
      try { await navigator.clipboard.writeText(text); return true; } catch {}
      const ta = document.createElement("textarea");
      ta.value = text; ta.setAttribute("readonly", ""); ta.style.cssText = "position:fixed;top:0;left:-9999px;opacity:0";
      document.body.appendChild(ta); ta.select();
      let ok = false;
      try { ok = document.execCommand("copy"); } catch {}
      ta.remove();
      return ok;
    };
    const prompt = () => `Need more information on "${docTitle}"\n\nSource: ${pageUrl}`;
    $$("[data-doc-action]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const action = btn.dataset.docAction;
        if (action === "chatgpt") return window.open(`https://chatgpt.com/?prompt=${encodeURIComponent(prompt())}`, "_blank", "noopener");
        if (action === "claude") return window.open(`https://claude.ai/new?q=${encodeURIComponent(prompt())}`, "_blank", "noopener");
        const label = $("[data-label]", btn);
        const ok = await copyText(toMarkdown());
        label.textContent = ok ? "Copied to clipboard!" : "Copy failed — try again";
        live.textContent = ok ? "Article copied to clipboard as Markdown." : "Copy failed.";
        btn.classList.toggle("is-done", ok);
        clearTimeout(btn._t);
        btn._t = setTimeout(() => { label.textContent = "Copy Markdown for LLM"; btn.classList.remove("is-done"); }, 2000);
      });
    });

    /* ---------- Doc tree: collapse + quick search ---------- */
    const tree = $("[data-tree]");
    const treeToggle = $(".tree__toggle", tree);
    const setTree = (open) => { tree.classList.toggle("is-collapsed", !open); treeToggle.setAttribute("aria-expanded", String(open)); };
    $("[data-tree-head]").addEventListener("click", () => setTree(tree.classList.contains("is-collapsed")));
    if (matchMedia("(max-width: 781px)").matches) setTree(false);   // phones: article first, tree one tap away

    const search = $("[data-doc-search]");
    const empty = $("[data-search-empty]");
    const items = $$("li", tree);
    const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
    items.forEach((li) => { const a = $(":scope > .tree__row a", li); a.dataset.text = a.textContent; });
    const linkOf = (li) => $(":scope > .tree__row a", li);
    const filter = () => {
      const q = search.value.trim().toLowerCase();
      const hits = new Set(items.filter((li) => !q || linkOf(li).dataset.text.toLowerCase().includes(q)));
      items.forEach((li) => {
        const a = linkOf(li), text = a.dataset.text, i = q ? text.toLowerCase().indexOf(q) : -1;
        li.hidden = !hits.has(li) && !$$("li", li).some((c) => hits.has(c));
        if (i >= 0) a.innerHTML = esc(text.slice(0, i)) + "<mark>" + esc(text.slice(i, i + q.length)) + "</mark>" + esc(text.slice(i + q.length));
        else a.textContent = text;
      });
      empty.hidden = hits.size > 0;
      if (q) setTree(true);
    };
    if (!/Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent)) $(".qs kbd").textContent = "Ctrl K";
    search.addEventListener("input", filter);
    search.addEventListener("keydown", (e) => {
      if (e.key === "Escape") { search.value = ""; filter(); search.blur(); }
      if (e.key === "Enter") { const first = items.find((li) => !li.hidden && $(":scope > .tree__row mark", li)); if (first) location.href = linkOf(first).href; }
    });
    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") { e.preventDefault(); search.focus(); search.select(); }
    });

    /* ---------- TOC: collapse on phones + scroll-spy active state ---------- */
    const toc = $("[data-toc]");
    const tocToggle = $(".toc__toggle", toc);
    tocToggle.addEventListener("click", () => {
      const open = toc.classList.contains("is-collapsed");
      toc.classList.toggle("is-collapsed", !open);
      tocToggle.setAttribute("aria-expanded", String(open));
    });
    const links = $$("a[href^='#toc-heading-']", toc);
    const heads = links.map((a) => document.getElementById(a.hash.slice(1)));
    let current = -1;
    const spy = () => {
      const line = Math.min(160, innerHeight * 0.3);
      let idx = -1;
      heads.forEach((h, i) => { if (h.getBoundingClientRect().top <= line) idx = i; });
      if (idx === current) return;
      current = idx;
      links.forEach((a, i) => { const on = i === idx; a.classList.toggle("is-active", on); on ? a.setAttribute("aria-current", "location") : a.removeAttribute("aria-current"); });
    };
    links.forEach((a, i) => a.addEventListener("click", () => { heads[i].setAttribute("tabindex", "-1"); setTimeout(() => heads[i].focus({ preventScroll: true }), 400); }));

    /* ---------- Font size switcher ---------- */
    const fs = $("[data-fontsize]");
    const fsBtns = $$("button", fs);
    const fsCur = $("[data-fontsize-current]", fs);
    const setScale = (btn) => {
      fsBtns.forEach((b) => { const on = b === btn; b.classList.toggle("is-active", on); b.setAttribute("aria-pressed", String(on)); });
      article.style.setProperty("--doc-scale", btn.dataset.scale);
      fsCur.textContent = `(${btn.dataset.name})`;
    };
    fsBtns.forEach((b) => b.addEventListener("click", () => { setScale(b); store.set("cp-doc-scale", b.dataset.scale); }));
    const saved = fsBtns.find((b) => b.dataset.scale === store.get("cp-doc-scale"));
    if (saved) setScale(saved);

    /* ---------- Was this helpful? ---------- */
    const helpful = $("[data-helpful]");
    const msg = $("[data-helpful-msg]", helpful);
    const voteBtns = $$("[data-vote]", helpful);
    const lock = (vote) => voteBtns.forEach((b) => { b.disabled = true; b.classList.toggle("is-voted", b.dataset.vote === vote); });
    const prev = store.get("cp-doc-vote");
    if (prev) { const b = voteBtns.find((x) => x.dataset.vote === prev); if (b) { const c = $("[data-count]", b); c.textContent = Number(c.textContent) + 1; lock(prev); } }
    voteBtns.forEach((b) => b.addEventListener("click", () => {
      const c = $("[data-count]", b);
      c.textContent = Number(c.textContent) + 1;
      lock(b.dataset.vote);
      store.set("cp-doc-vote", b.dataset.vote);
      msg.textContent = "Thank you for your feedback!";
    }));

    /* ---------- Print ---------- */
    $("[data-print]").addEventListener("click", (e) => { e.preventDefault(); window.print(); });

    /* ---------- Reading progress ---------- */
    const fill = $("[data-read-fill]");
    const left = $("[data-read-left]");
    const words = (body.textContent.match(/\S+/g) || []).length;
    const progress = () => {
      const r = article.getBoundingClientRect();
      const total = r.height - innerHeight * 0.6;
      const p = Math.min(1, Math.max(0, (-r.top + innerHeight * 0.2) / Math.max(1, total)));
      fill.style.transform = `scaleX(${p})`;
      const mins = Math.ceil((words * (1 - p)) / 200);
      left.textContent = p >= 1 || mins <= 0 ? "📖 Finished reading" : `📖 ${mins} min left`;
    };

    let ticking = false;
    const onScroll = () => { if (ticking) return; ticking = true; requestAnimationFrame(() => { ticking = false; spy(); progress(); }); };
    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", onScroll);
    spy(); progress();
  })();
</script>
</Fragment>
