<Fragment slot="scripts">
<script is:inline>
  /* Complete commerce agent: the tab row follows the card in view.
     Pinned (≥1024px, motion allowed, stage fits the viewport): the section is made (stage height + travel) tall,
     the stage sticks and the track is carried right → left with scroll, smoothed like a scrubbed tween.
     Otherwise the cards sit in a native swipe row with scroll-snap. Tabs jump to their card either way. */
  (() => {
    const sec = document.querySelector(".fca");
    if (!sec) return;
    const pin = sec.querySelector(".fca__pin"), stage = sec.querySelector(".fca__stage"), nav = sec.querySelector(".fca__tabs");
    const vp = sec.querySelector(".fca__viewport"), track = sec.querySelector(".fca__track");
    const cards = [...track.children], tabs = [...nav.querySelectorAll(".fca__tab")];
    const mq = matchMedia("(min-width: 1024px) and (prefers-reduced-motion: no-preference)");
    let on = false, travel = 0, step = 1, cur = 0, raf = 0, active = 0;

    const setActive = (i) => {
      i = Math.max(0, Math.min(cards.length - 1, i));
      if (i === active) return;
      active = i;
      cards.forEach((c, k) => c.classList.toggle("is-active", k === i));
      tabs.forEach((t, k) => { t.classList.toggle("is-active", k === i); k === i ? t.setAttribute("aria-current", "true") : t.removeAttribute("aria-current"); });
      const t = tabs[i];
      if (nav.scrollWidth > nav.clientWidth) nav.scrollTo({ left: t.offsetLeft - (nav.clientWidth - t.offsetWidth) / 2, behavior: "smooth" });
    };
    let st = 0; /* sticky offset that centres the stage in the viewport */
    const goal = () => Math.min(travel, Math.max(0, st - pin.getBoundingClientRect().top));
    const tick = () => {
      cancelAnimationFrame(raf);
      const frame = () => {
        if (!on) return;
        const t = goal();
        cur += (t - cur) * 0.14;
        if (Math.abs(t - cur) < 0.3) cur = t;
        track.style.transform = `translate3d(${-cur}px, 0, 0)`;
        setActive(Math.round(cur / step));
        if (cur !== t) raf = requestAnimationFrame(frame);
      };
      raf = requestAnimationFrame(frame);
    };
    const off = () => { on = false; sec.classList.remove("is-pinned"); pin.style.height = ""; track.style.transform = ""; cur = 0; };
    const measure = () => {
      if (!mq.matches) return off();
      sec.classList.add("is-pinned");
      if (stage.offsetHeight > innerHeight) return off();
      on = true;
      st = Math.max(0, Math.round((innerHeight - stage.offsetHeight) / 2));
      stage.style.setProperty("--st", st + "px");
      step = cards[1].offsetLeft - cards[0].offsetLeft;
      travel = step * (cards.length - 1);
      pin.style.height = stage.offsetHeight + travel + "px";
      cur = goal();
      tick();
    };
    /* swipe row: pick the card closest to the centre */
    vp.addEventListener("scroll", () => {
      if (on) return;
      const mid = vp.scrollLeft + vp.clientWidth / 2;
      let best = 0, d = Infinity;
      cards.forEach((c, k) => { const m = Math.abs(c.offsetLeft + c.offsetWidth / 2 - mid); if (m < d) { d = m; best = k; } });
      setActive(best);
    }, { passive: true });
    tabs.forEach((t, i) => t.addEventListener("click", () => {
      if (on) scrollTo({ top: pin.getBoundingClientRect().top + scrollY - st + i * step, behavior: "smooth" });
      else vp.scrollTo({ left: cards[i].offsetLeft - (vp.clientWidth - cards[i].offsetWidth) / 2, behavior: "smooth" });
    }));
    nav.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
      const i = tabs.indexOf(document.activeElement);
      if (i < 0) return;
      const n = tabs[(i + (e.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length];
      n.focus(); n.click(); e.preventDefault();
    });
    addEventListener("scroll", () => on && tick(), { passive: true });
    addEventListener("resize", measure);
    mq.addEventListener("change", measure);
    (document.fonts ? document.fonts.ready : Promise.resolve()).then(measure);
    addEventListener("load", () => { measure(); setTimeout(() => cards.forEach((c) => { const im = c.querySelector("img"); if (im) im.loading = "eager"; }), 600); });
  })();
</script>
</Fragment>
